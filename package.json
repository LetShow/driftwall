{
  "name": "driftwall",
  "version": "1.0.0",
  "description": "Driftwall · AI 随机壁纸引擎：LLM 生成提示词 → 文生图 → 设为桌面壁纸，并按你的喜好自我进化",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "test": "node --test test/adapters.test.js",
    "pack": "electron-builder"
  },
  "build": {
    "appId": "com.driftwall.app",
    "productName": "Driftwall",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Driftwall-${version}-portable.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!db/**/*",
      "!images/**/*",
      "!temp/**/*",
      "!preload/**/*",
      "!dist/**/*",
      "!test/**/*",
      "!*.md"
    ]
  },
  "keywords": [
    "wallpaper",
    "electron",
    "ai",
    "llm",
    "text-to-image",
    "wallpaper-engine",
    "windows",
    "desktop"
  ],
  "author": "LetShow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LetShow/driftwall.git"
  },
  "homepage": "https://github.com/LetShow/driftwall#readme",
  "bugs": {
    "url": "https://github.com/LetShow/driftwall/issues"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "node-cron": "^3.0.0",
    "sql.js": "^1.9.0",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0"
  }
}
